 "variants": {
  "facet": {
   "name": "Facet",
   "direction": "Crisp chamfered",
   "extends": null,
   "interface": "IF1",
   "tagline": "Crisp chamfered octagons",
   "text": "Plain planar faces with 45° chamfers: a 1.6 mm crown on the base, 0.9 mm on each pedestal, 0.8 mm bevels on the glyph faces. The strongest silhouettes and the least ambiguity at arm's length; the tier steps read as clean ledges.",
   "tactile": "Hard, precise edges. Chamfers take fingernails for separating layers.",
   "print": "Simplest to print: straight walls, 45° chamfers, no ornament.",
   "risk": "Chamfered glyph tips are the sharpest points in the project. They are rounded by the 0.35 mm outline offset, but should still be checked."
  },
  "pebble": {
   "name": "Pebble",
   "direction": "Soft octagonal",
   "extends": null,
   "interface": "IF1",
   "tagline": "Soft octagonal, rounded edges",
   "text": "The octagon keeps its flats but its eight corners are rounded (3.0–3.4 mm) and every top edge is a quarter-round. Glyphs have a 1.2 mm rounded face edge. Quiet, tactile, friendly; still unmistakably octagonal.",
   "tactile": "Warm and pebble-like in the hand; no corners to catch.",
   "print": "Rounded top edges print as fine terraces at 0.2 mm layers (0.12–0.16 mm layers look smoother). Larger files.",
   "risk": "Softer step edges make the T2/T3 ledges slightly less crisp from far away. The rounded tile top is 0.8 mm; a 1.0 mm round failed in the kernel at the puzzle-tab necks."
  },
  "turned": {
   "name": "Turned Court",
   "direction": "Restrained turned / fluted",
   "extends": null,
   "interface": "IF1",
   "tagline": "Turned Court: plinth, crown and broad flutes",
   "text": "Informed by the earlier Turned Court / Baroque studies, without their tall monolithic figurines: a stepped plinth and filleted crown on the base, eight broad flutes (1.5 mm radius) on each pedestal and a raised, inset plateau on every glyph. Tiles carry a court frame groove around the piece area.",
   "tactile": "Architectural; the flutes give the pedestals grip and make the tier layers countable by touch.",
   "print": "All ornament is vertical or stepped, so no supports. Flutes are 3 mm wide and 0.7 mm deep, well above minimum feature size.",
   "risk": "Most visual detail, so dust and stringing show more. Keep the flute count and depth; do not add finer ornament."
  },
  "turned-keyed": {
   "name": "Turned Court · Keyed",
   "direction": "Restrained turned / fluted — solid pedestals, IF2 keyed flex joints, tier dots",
   "extends": "turned",
   "interface": "IF2-keyed",
   "tagline": "Turned Court with keyed flex joints and tier dots (solid pedestals)",
   "text": "Same glyphs, tiles and silhouette as Turned Court. The joints are new (IF2): a 2.8 mm tube collar on each pedestal enters an annular groove under the layer above, where four flex beams with small bumps grip it; they bend along the print layers, not across them, so the clutch stays consistent and does not wear like crush ribs. A key at the back lets each layer on one way only, so a turquoise tier dot on every layer lines up at the front: one dot on T1, two on T2, three on T3. Collars differ per tier, so a base cannot sit on a T3.",
   "tactile": "Aims for the Lego feel: seats with a firm push, stays together in play, pulls apart with a good grip. The preload is tunable with the IF2 coupon sweep.",
   "print": "Upright, no supports; the groove ceilings are 2 mm annular bridges. Each piece is two parts on the plate (body + dot), so the army plates need a second filament (turquoise).",
   "risk": "Retention force is estimated, not measured: print the IF2 socket sweep. Multi-filament plates are sliced as geometry only here; check dot assignment in Bambu Studio."
  },
  "turned-ring": {
   "name": "Turned Court · Rings",
   "direction": "Restrained turned / fluted — hollow ring pedestals, IF2 keyed flex joints, tier dots",
   "extends": "turned",
   "interface": "IF2-ring",
   "tagline": "Turned Court rings: hollow T2/T3 with keyed flex joints and tier dots",
   "text": "As Turned Court · Keyed, but T2 and T3 are rings: open through the collar bore, with the flex-beam groove cut into the ring wall. About a third lighter (T2 −36 %, T3 −28 % volume) and no large bridged ceilings.",
   "tactile": "Lighter in the hand; a promoted piece sits a little less planted.",
   "print": "Upright, no supports; the ring walls print as closed loops. Same two-filament plates as Keyed.",
   "risk": "Lower mass and a hollow centre make a T3 tip more easily if knocked. The thinner ring walls matter more in the drop test. Two T2 rings can be stacked loosely (the ring bore takes a T2 collar without gripping it)."
  }
 },
